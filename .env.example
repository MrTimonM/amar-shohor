# ---------------------------------------------------------------------------
# Amar Shohor — copy to .env and adjust. Nothing in the tree hardcodes these.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API ---
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173

# --- Database ---
# Docker Compose provides this. For Atlas, paste the SRV string instead.
MONGO_URL=mongodb://localhost:27017/amar_shohor

# --- Auth ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production-48-random-bytes
JWT_TTL=7d


# --- Storage (phase 06) ---
# local  -> apps/api/var/uploads, served at /uploads
# s3     -> set the AWS_* vars below
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- AI service (phase 08) ---
# The API works with this down: reports still succeed and enrich later.
AI_SERVICE_URL=http://localhost:8000
AI_ENABLED=true

# --- Dedup thresholds (phase 10) ---
DEDUP_AUTO_MERGE=0.72
DEDUP_REVIEW=0.50
DEDUP_RADIUS_M=120
DEDUP_WINDOW_DAYS=45

# --- Verification (phase 12) ---
VERIFY_THRESHOLD=3
VERIFY_PROXIMITY_M=400

# --- Email sign-in (phase 04) ---
# One request sends BOTH a six-digit code and a magic link; either signs in.
# SMTP_ACCOUNTS is `user:pass,user:pass` — tried in order, with a 5-minute
# cooldown on any account that refuses, because consumer mailboxes rate-limit
# and lock without warning.
#
# GMX will not authenticate SMTP until "Access to this account via POP3/IMAP"
# is enabled in each mailbox's settings. A 535 auth error is almost always that.
SMTP_HOST=mail.gmx.com
SMTP_PORT=587
SMTP_ACCOUNTS=sender1@example.com:password1,sender2@example.com:password2
MAIL_FROM_NAME=Amar Shohor
LOGIN_CODE_TTL_MINUTES=15
WEB_PUBLIC_URL=http://localhost:5173

# --- Seeded staff identities ---
# Phone sign-in has no SMS gateway yet, so the admin and department accounts
# are given real addresses; otherwise they would be unreachable.
SEED_ADMIN_EMAIL=
SEED_STAFF_EMAILS=
SMS_ENABLED=false
